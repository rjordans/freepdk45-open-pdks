** FreePDK45 model library
.lib tt
* SPICE NOM
* nominal operating corner (average operating corner)

.inc ./tran_models/models_nom/NMOS_VTG.inc
.inc ./tran_models/models_nom/PMOS_VTG.inc

.inc ./tran_models/models_nom/NMOS_VTL.inc
.inc ./tran_models/models_nom/PMOS_VTL.inc

.inc ./tran_models/models_nom/NMOS_VTH.inc
.inc ./tran_models/models_nom/PMOS_VTH.inc

.inc ./tran_models/models_nom/NMOS_THKOX.inc
.inc ./tran_models/models_nom/PMOS_THKOX.inc
.endl tt
           
* SPICE FF
.lib ff      
* fast-fast corner (fastest operating corner)

.inc ./tran_models/models_ff/NMOS_VTG.inc
.inc ./tran_models/models_ff/PMOS_VTG.inc

.inc ./tran_models/models_ff/NMOS_VTL.inc
.inc ./tran_models/models_ff/PMOS_VTL.inc

.inc ./tran_models/models_ff/NMOS_VTH.inc
.inc ./tran_models/models_ff/PMOS_VTH.inc

.inc ./tran_models/models_ff/NMOS_THKOX.inc
.inc ./tran_models/models_ff/PMOS_THKOX.inc
.endl ff


.lib ss
 
* SPICE SS
* slow-slow corner (slowest operating corner)
.inc ./tran_models/models_ss/NMOS_VTG.inc
.inc ./tran_models/models_ss/PMOS_VTG.inc

.inc ./tran_models/models_ss/NMOS_VTL.inc
.inc ./tran_models/models_ss/PMOS_VTL.inc

.inc ./tran_models/models_ss/NMOS_VTH.inc
.inc ./tran_models/models_ss/PMOS_VTH.inc

.inc ./tran_models/models_ss/NMOS_THKOX.inc
.inc ./tran_models/models_ss/PMOS_THKOX.inc
.endl
